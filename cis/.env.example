# --- Used by `docker compose up` (reads this file automatically as .env) ---
# DATABASE_URL is NOT read from here when running via docker compose —
# compose sets it itself to point at the cis-db container by service name.
# It's only needed below for running the API directly on the host (no Docker).

# FIXED DEMO VALUE — Mphamvu Hub does not exist as a running service yet,
# so there is no second codebase to coordinate a real secret with. This
# value works out of the box for CIS running standalone today. The moment
# the Mphamvu Hub repo exists, copy this exact string into ITS .env as
# CIS_CONSENT_SECRET too — from then on it's a real shared secret between
# two services, and you should rotate it to something random at that point
# (this fixed value is fine for local hackathon dev, not for anything public).
CIS_CONSENT_SECRET=mphamvu-hackathon-demo-shared-secret-2026

# Format: clientId:bcryptHashOfSecret
# The hash below corresponds to the plaintext secret "mphamvu-hub-demo-secret-2026"
# — that plaintext is what Mphamvu Hub's API will send as the Client-Secret
# header once it exists. Multiple clients can be comma-separated: id1:hash1,id2:hash2
# NOTE: every literal $ below is doubled ($$) — Docker Compose treats a
# single $ in .env as the start of a variable reference and will silently
# blank it out otherwise. The hash itself is unchanged; $$ collapses to $.
TRUSTED_CLIENTS=mphamvu-hub:$$2b$$10$$ZjfJAGQeYk3GikQZsj4MKe3uDJu74v3n/FRxZzklHzFxlQolM5AWO

# FIXED DEMO VALUE — shared only between CIS and the USSD simulators.
# A completely separate secret from CIS_CONSENT_SECRET above: this one
# protects CIS's own internal write path (the simulators acting as "the
# telecom's own systems"), not the external consent-gated read path.
INTERNAL_GATEWAY_SECRET=mphamvu-hackathon-internal-gateway-key-2026

# The browser origin the USSD simulators run on (Vite's default port).
# Only relevant for CORS — Mphamvu Hub's own API calls CIS server-to-
# server and is unaffected.
SIMULATOR_ORIGIN=http://localhost:5173

# --- Only needed if running `npm run dev` directly on the host, no Docker ---
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5435/cis_dev
